<Window x:Class="FluentSSH.Dialogs.HostDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建主机"
        Width="660"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="DialogTitle" Text="新建主机" Style="{StaticResource PageTitleStyle}" />
            <CheckBox x:Name="FavoriteCheck" Content="收藏" Margin="18,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="名称" Style="{StaticResource FormLabelStyle}" />
                <TextBox x:Name="NameBox" Style="{StaticResource InputTextBoxStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="分组" Style="{StaticResource FormLabelStyle}" />
                <ComboBox x:Name="GroupBox" Style="{StaticResource InputComboBoxStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="地址" Style="{StaticResource FormLabelStyle}" />
                <TextBox x:Name="HostnameBox" Style="{StaticResource InputTextBoxStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="端口" Style="{StaticResource FormLabelStyle}" />
                <TextBox x:Name="PortBox" Style="{StaticResource InputTextBoxStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="用户名" Style="{StaticResource FormLabelStyle}" />
                <TextBox x:Name="UsernameBox" Style="{StaticResource InputTextBoxStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource HairlineStyle}" Margin="0,18,0,16" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="认证方式" Style="{StaticResource FormLabelStyle}" />
                <ComboBox x:Name="AuthBox" Style="{StaticResource InputComboBoxStyle}" SelectionChanged="AuthBox_SelectionChanged">
                    <ComboBoxItem Content="密码" Tag="Password" />
                    <ComboBoxItem Content="私钥" Tag="PrivateKey" />
                    <ComboBoxItem Content="交互式" Tag="KeyboardInteractive" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <StackPanel x:Name="PasswordPanel">
                    <TextBlock x:Name="PasswordLabel" Text="密码" Style="{StaticResource FormLabelStyle}" />
                    <PasswordBox x:Name="PasswordBoxControl" Style="{StaticResource InputPasswordBoxStyle}" />
                </StackPanel>
                <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
                    <TextBlock Text="私钥" Style="{StaticResource FormLabelStyle}" />
                    <ComboBox x:Name="KeyBox" Style="{StaticResource InputComboBoxStyle}" />
                    <TextBlock x:Name="KeyPassphraseLabel" Text="私钥口令" Margin="0,10,0,6" Style="{StaticResource FormLabelStyle}" />
                    <PasswordBox x:Name="PassphraseBox" Style="{StaticResource InputPasswordBoxStyle}" />
                </StackPanel>
                <StackPanel x:Name="KeyboardPanel" Visibility="Collapsed">
                    <TextBlock Text="连接时由服务器提示输入验证码或密码。" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Height="32" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="标签" Style="{StaticResource FormLabelStyle}" />
                <TextBox x:Name="TagsBox" Style="{StaticResource InputTextBoxStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="最近连接" Style="{StaticResource FormLabelStyle}" />
                <TextBlock x:Name="LastConnectedText" Height="32" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
        </Grid>

        <Expander Grid.Row="6" Margin="0,18,0,0" Header="更多选项" IsExpanded="False">
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="启动命令" Style="{StaticResource FormLabelStyle}" />
                    <TextBox x:Name="StartupBox" Style="{StaticResource InputTextBoxStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="默认目录" Style="{StaticResource FormLabelStyle}" />
                    <TextBox x:Name="DefaultPathBox" Style="{StaticResource InputTextBoxStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <TextBlock Text="备注" Style="{StaticResource FormLabelStyle}" />
                    <TextBox x:Name="NotesBox" Style="{StaticResource InputTextBoxStyle}" Height="64" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" />
                </StackPanel>
                <CheckBox x:Name="KeepAliveCheck" Grid.Row="2" Grid.Column="0" Content="保持连接" Margin="0,12,0,0" IsChecked="True" />
            </Grid>
        </Expander>

        <Border Grid.Row="7" Style="{StaticResource HairlineStyle}" Margin="0,18,0,16" />

        <TextBlock x:Name="ValidationText" Grid.Row="8" Foreground="{DynamicResource AppDangerBrush}" FontSize="12"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Width="80" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource SecondaryButtonStyle}" MinWidth="80" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="保存并连接" Style="{StaticResource PrimaryButtonStyle}" MinWidth="112" Click="SaveAndConnect_Click" />
        </StackPanel>
    </Grid>
</Window>
