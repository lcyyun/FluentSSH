<Window x:Class="FluentSSH.Dialogs.GroupManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理分组"
        Width="460"
        Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="分组" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="GroupNameBox" Style="{StaticResource InputTextBoxStyle}" />
            <Button Grid.Column="2" Content="添加分组" Style="{StaticResource SecondaryButtonStyle}" Click="AddGroup_Click" />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0.5" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GroupList" Margin="6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,0.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                                    <Button Grid.Column="1" Content="删除" Style="{StaticResource SubtleButtonStyle}" Tag="{Binding}"
                                            Click="DeleteGroup_Click" Foreground="{DynamicResource AppDangerBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="完成" Style="{StaticResource PrimaryButtonStyle}" Width="88" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
