<ui:FluentWindow x:Class="FluentSSH.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="FluentSSH"
                 Icon="Assets/app.ico"
                 Width="1500"
                 Height="950"
                 MinWidth="1080"
                 MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource AppBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                 TextOptions.TextFormattingMode="Display"
                 PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="FluentSSH" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource AppBackgroundAltBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0.5,0">
                <Grid Margin="12,16,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Style="{StaticResource PrimaryButtonStyle}" Margin="2,0,2,18"
                            HorizontalContentAlignment="Center" Click="NewHost_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE710;" VerticalAlignment="Center" />
                            <TextBlock Text="新建主机" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Row="1">
                        <TextBlock Margin="9,0,0,5" Text="工作区" Style="{StaticResource CaptionTextStyle}" />
                        <ListBox x:Name="NavList" Style="{StaticResource NavListBoxStyle}" SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem Tag="hosts">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Width="23" VerticalAlignment="Center" Text="&#xE80F;" />
                                    <TextBlock Text="主机" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="terminal">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Width="23" VerticalAlignment="Center" Text="&#xE756;" />
                                    <TextBlock Text="终端" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="files">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Width="23" VerticalAlignment="Center" Text="&#xE8B7;" />
                                    <TextBlock Text="文件" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <TextBlock Margin="9,16,0,5" Text="工具" Style="{StaticResource CaptionTextStyle}" />
                        <ListBox x:Name="ToolNavList" Style="{StaticResource NavListBoxStyle}" SelectionChanged="ToolNavList_SelectionChanged">
                            <ListBoxItem Tag="tunnels">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Width="23" VerticalAlignment="Center" Text="&#xE968;" />
                                    <TextBlock Text="隧道" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="commands">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Width="23" VerticalAlignment="Center" Text="&#xE943;" />
                                    <TextBlock Text="命令与片段" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="security">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Width="23" VerticalAlignment="Center" Text="&#xE72E;" />
                                    <TextBlock Text="密钥与信任" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="logs">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Width="23" VerticalAlignment="Center" Text="&#xE8A5;" />
                                    <TextBlock Text="日志" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Border Style="{StaticResource HairlineStyle}" Margin="7,0,7,10" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="ThemeButton" Style="{StaticResource CircleIconButtonStyle}"
                                    Click="ToggleTheme_Click" ToolTip="切换到深色模式"
                                    AutomationProperties.Name="切换深浅色主题">
                                <TextBlock x:Name="ThemeGlyph" FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE708;" />
                            </Button>
                            <Button x:Name="SettingsButton" Style="{StaticResource CircleIconButtonStyle}"
                                    Click="Settings_Click" ToolTip="设置" AutomationProperties.Name="设置">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE713;" />
                            </Button>
                            <Button x:Name="GitHubButton" Style="{StaticResource CircleIconButtonStyle}"
                                    Click="GitHub_Click" ToolTip="GitHub 仓库" AutomationProperties.Name="GitHub 仓库">
                                <Viewbox Width="15" Height="15">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</ui:FluentWindow>
