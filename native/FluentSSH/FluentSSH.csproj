<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FluentSSH</AssemblyName>
    <RootNamespace>FluentSSH</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Authors>FluentSSH</Authors>
    <Product>FluentSSH</Product>
    <Description>Native SSH workspace for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="WPF-UI" Version="4.1.0" />
    <PackageReference Include="XtermSharp.Wpf" Version="0.1.0-alpha.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app-icon.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
