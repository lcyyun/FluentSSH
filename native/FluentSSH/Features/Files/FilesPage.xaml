<UserControl x:Class="FluentSSH.Features.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="FileRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AppSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="文件" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="FileCountText" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="UploadButton" Content="上传" Style="{StaticResource PrimaryButtonStyle}" Click="Upload_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="HostPicker" Style="{StaticResource InputComboBoxStyle}" VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13" />
                            <TextBlock Text="{Binding Address}" FontSize="12" Margin="10,0,0,0" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="ConnectButton" Grid.Column="1" Content="连接" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="ConnectButton_Click" />
            <Button x:Name="DisconnectButton" Grid.Column="2" Content="断开" Style="{StaticResource SubtleButtonStyle}" Margin="4,0,0,0" Click="DisconnectButton_Click" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
        </Grid>

        <Grid x:Name="PathBar" Grid.Row="2" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="&#xE72B;" Style="{StaticResource IconButtonStyle}" Click="Up_Click" ToolTip="上级目录" />
            <Button Grid.Column="1" Content="&#xE72C;" Style="{StaticResource IconButtonStyle}" Click="Refresh_Click" ToolTip="刷新" />
            <TextBlock Grid.Column="2" Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="6,0,8,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextTertiaryBrush}" />
            <TextBox x:Name="PathBox" Grid.Column="3" Style="{StaticResource InputTextBoxStyle}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     KeyDown="PathBox_KeyDown" />
            <Button Grid.Column="4" Content="转到" Style="{StaticResource SubtleButtonStyle}" Margin="6,0,10,0" Click="Go_Click" />
            <StackPanel Grid.Column="5" Orientation="Horizontal">
                <Button x:Name="NewFolderButton" Content="新建文件夹" Style="{StaticResource SubtleButtonStyle}" Click="NewFolder_Click" Margin="0,0,2,0" />
                <Button x:Name="OpenButton" Content="打开" Style="{StaticResource SubtleButtonStyle}" Click="Open_Click" Margin="0,0,2,0" />
                <Button x:Name="DownloadButton" Content="下载" Style="{StaticResource SubtleButtonStyle}" Click="Download_Click" Margin="0,0,2,0" />
                <Button x:Name="RenameButton" Content="重命名" Style="{StaticResource SubtleButtonStyle}" Click="Rename_Click" Margin="0,0,2,0" />
                <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource SubtleButtonStyle}" Click="Delete_Click" Foreground="{DynamicResource AppDangerBrush}" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="EmptyState" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="30"
                       Foreground="{DynamicResource AppTextTertiaryBrush}" Text="&#xE8B7;" />
            <TextBlock Margin="0,12,0,0" Text="选择主机并连接" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
            <Button Margin="0,16,0,0" Content="连接选中主机" Style="{StaticResource PrimaryButtonStyle}" Click="ConnectButton_Click" />
        </StackPanel>

        <Border x:Name="FilePanel" Grid.Row="3" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0.5" CornerRadius="10" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0.5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="14,0" Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="名称" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="26,0,0,0" />
                    <TextBlock Grid.Column="1" Text="大小" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="修改时间" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource HairlineStyle}" />
                <ListBox x:Name="FileList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource FileRowStyle}" SelectionChanged="FileList_SelectionChanged"
                         MouseDoubleClick="FileList_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="15"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" FontFamily="Cascadia Mono, Consolas" />
                                <TextBlock Grid.Column="2" Text="{Binding ModifiedLabel}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyFolderText" Grid.Row="2" Text="此目录为空" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="TransferBar" Orientation="Horizontal" Visibility="Collapsed">
                <ProgressBar x:Name="TransferProgress" Width="220" Height="3" Minimum="0" Maximum="100" />
                <TextBlock x:Name="TransferText" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <TextBlock x:Name="CurrentPathText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"
                       FontFamily="Cascadia Mono, Consolas" />
        </Grid>
    </Grid>
</UserControl>
