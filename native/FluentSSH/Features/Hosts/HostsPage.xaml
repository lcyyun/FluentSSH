<UserControl x:Class="FluentSSH.Features.HostsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FluentSSH.Converters"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="主机" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="HostCountText" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="导入 SSH Config" Style="{StaticResource SecondaryButtonStyle}" Click="ImportSshConfig_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Click="NewHost_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE710;" VerticalAlignment="Center" />
                        <TextBlock Text="新建主机" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBoxStyle}" Padding="30,6,10,6"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="SearchHint" Text="搜索主机" Margin="30,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE721;" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource AppTextTertiaryBrush}" IsHitTestVisible="False" />
            </Grid>
            <ComboBox x:Name="GroupFilter" Grid.Column="1" Width="150" Margin="10,0,0,0"
                      Style="{StaticResource InputComboBoxStyle}" SelectionChanged="GroupFilter_SelectionChanged" />
            <Button Grid.Column="3" Content="管理分组" Style="{StaticResource SubtleButtonStyle}" Click="ManageGroups_Click" />
        </Grid>

        <Border x:Name="HostPanel" Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0.5" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0.5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,0" Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="主机" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="2" Text="分组" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="3" Text="认证" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="4" Text="最近连接" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource HairlineStyle}" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="HostList" Margin="0,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="0,0,0,0.5" Padding="16,10" MouseLeftButtonDown="HostRow_MouseLeftButtonDown"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="132" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" Background="{DynamicResource AppSurfaceHoverBrush}">
                                            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="★" Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}"
                                                           FontSize="12" Margin="6,0,0,0" Foreground="{DynamicResource AppAccentBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Address}" Margin="0,2,0,0" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding GroupName}" VerticalAlignment="Center"
                                                   Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                        <Border Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AuthLabel}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding LastConnectedLabel}" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="&#xE756;" Tag="{Binding}" Style="{StaticResource ListRowButtonStyle}"
                                                    ToolTip="打开终端" Click="ConnectHost_Click" />
                                            <Button Content="&#xE8B7;" Tag="{Binding}" Style="{StaticResource ListRowButtonStyle}"
                                                    ToolTip="打开文件" Click="FilesHost_Click" />
                                            <Button Content="&#xE70F;" Tag="{Binding}" Style="{StaticResource ListRowButtonStyle}"
                                                    ToolTip="编辑主机" Click="EditHost_Click" />
                                            <Button Content="&#xE74D;" Tag="{Binding}" Style="{StaticResource ListRowButtonStyle}"
                                                    ToolTip="删除主机" Click="DeleteHost_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="30"
                       Foreground="{DynamicResource AppTextTertiaryBrush}" Text="&#xE80F;" />
            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Text="还没有主机" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
            <Button Margin="0,16,0,0" Content="新建主机" Style="{StaticResource PrimaryButtonStyle}" Click="NewHost_Click" />
        </StackPanel>
    </Grid>
</UserControl>
