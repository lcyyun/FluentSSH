<UserControl x:Class="FluentSSH.Features.TunnelsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="TunnelRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="隧道" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="TunnelCountText" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Click="NewTunnel_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE710;" VerticalAlignment="Center" />
                    <TextBlock Text="新建隧道" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="30"
                       Foreground="{DynamicResource AppTextTertiaryBrush}" Text="&#xE968;" />
            <TextBlock Margin="0,12,0,0" Text="还没有隧道" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
            <Button Margin="0,16,0,0" Content="新建隧道" Style="{StaticResource PrimaryButtonStyle}" Click="NewTunnel_Click" />
        </StackPanel>

        <Border x:Name="TunnelPanel" Grid.Row="1" Margin="0,18,0,0" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0.5" CornerRadius="10" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0.5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="16,0" Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="名称" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="路由" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="主机" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource HairlineStyle}" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TunnelList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,0.5" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource AppTextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                <Setter Property="Fill" Value="{DynamicResource AppDangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding RouteLabel}" Style="{StaticResource SecondaryTextStyle}"
                                                   FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding HostName}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button x:Name="StartButton" Content="启动" Tag="{Binding}" Style="{StaticResource TunnelRowButtonStyle}" Click="StartTunnel_Click" />
                                            <Button x:Name="StopButton" Content="停止" Tag="{Binding}" Style="{StaticResource TunnelRowButtonStyle}" Click="StopTunnel_Click" Visibility="Collapsed" />
                                            <Button Content="编辑" Tag="{Binding}" Style="{StaticResource TunnelRowButtonStyle}" Click="EditTunnel_Click" />
                                            <Button Content="删除" Tag="{Binding}" Style="{StaticResource TunnelRowButtonStyle}" Foreground="{DynamicResource AppDangerBrush}" Click="DeleteTunnel_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                        <Setter TargetName="StartButton" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="StopButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
